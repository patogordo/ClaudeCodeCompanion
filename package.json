{
  "name": "claude-code-companion",
  "description": "Robozinho de mesa com olhos de LED que mostram, por Bluetooth, o que o Claude Code está fazendo",
  "license": "MIT",
  "repository": "github:patogordo/ClaudeCodeCompanion",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3500",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firmware": "arduino-cli compile --fqbn esp32:esp32:XIAO_ESP32C3 --output-dir firmware/build firmware",
    "sim": "wokwi-cli firmware --interactive --timeout 600000",
    "sim:test": "wokwi-cli firmware --scenario test.scenario.yaml --timeout 60000"
  },
  "dependencies": {
    "nuxt": "4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/web-bluetooth": "^0.0.22",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
